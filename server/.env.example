# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Persistent local MongoDB. Start it first, in its own terminal:  npm run db:start
# (Data is stored in server/.mongodb-data and survives restarts.)
# For a hosted database, replace this with your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/dayflow_hrms

# Optional: where the local database files live (defaults to server/.mongodb-data)
# MONGO_DB_PATH=

# Escape hatch ONLY for a throwaway demo — starts a temporary in-memory database
# whose data is DELETED when the server stops. Leave this unset for real testing.
# ALLOW_MEMORY_DB=true

# Skip the automatic demo seed on an empty database
# AUTO_SEED=false

# --- Auth ---
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=7d
